# Groq API Key (получить можно на https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Модели для сравнения (День 5: слабая, средняя, сильная на Groq API):
# 1. Слабая модель (~20B параметров)
MODEL_WEAK=openai/gpt-oss-20b

# 2. Средняя модель (~27B параметров)
MODEL_MEDIUM=qwen/qwen3.6-27b

# 3. Сильная модель (~120B параметров)
MODEL_STRONG=openai/gpt-oss-120b
